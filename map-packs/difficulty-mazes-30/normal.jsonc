      "mechanics": [
        {
          "id": "archive-d",
          "type": "LOGIC_ANSWER",
          "question": "점과 선 장치로 LOVE의 모스 신호를 입력해 네 글자를 점등하세요. 그 뒤 연상되는 제목을 채팅으로 제출하세요.",
          "pages": [
            "점과 선 장치로 LOVE의 모스 신호를 입력해 네 글자를 점등하세요. 그 뒤 연상되는 제목을 채팅으로 제출하세요."
          ],
          "answerFormat": "띄어쓰기 없는 한글",
          "answers": [
            "사랑과전쟁"
          ],
          "normalization": "LETTERS_AND_DIGITS",
          "cooldownSeconds": 14,
          "difficulty": 3,
          "inspiration": "심야의 기록보관소 · 점과 선의 통역",
