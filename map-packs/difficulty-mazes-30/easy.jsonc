      "completionMode": "ALL_MECHANICS",
      "mechanics": [
        {
          "id": "archive-c",
          "type": "LOGIC_ANSWER",
          "question": "목표\n흩어진 일곱 기록을 무지개색 순서로 복원해 숨은 네 글자 성어를 찾으세요.\n\n관찰\n색 띠는 순서가 섞여 있습니다. 각 띠에서 발견한 기록의 마지막 글자를 적어 두세요.\n\n입력\n일곱 띠를 모두 조사한 뒤 완성 문장의 앞 네 글자를 채팅으로 제출하세요.",
          "pages": [
            "목표\n흩어진 일곱 기록을 무지개색 순서로 복원해 숨은 네 글자 성어를 찾으세요.\n\n관찰\n색 띠는 순서가 섞여 있습니다. 각 띠에서 발견한 기록의 마지막 글자를 적어 두세요.\n\n입력\n일곱 띠를 모두 조사한 뒤 완성 문장의 앞 네 글자를 채팅으로 제출하세요."
          ],
          "answerFormat": "한글 4글자",
          "answers": [
            "주경야독"
          ],
          "normalization": "LETTERS_AND_DIGITS",
          "cooldownSeconds": 10,
