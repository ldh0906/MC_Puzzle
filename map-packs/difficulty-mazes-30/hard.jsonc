      "completionMode": "ALL_MECHANICS",
      "mechanics": [
        {
          "id": "archive-z",
          "type": "LOGIC_ANSWER",
          "question": "봉인 과정을 역순으로 적용하고 마지막에 덧붙인 두 글자를 제거하세요.",
          "pages": [
            {
              "layout": "GRID",
              "text": "암호판\nA L H\nB O R\nD S Y"
            },
            "봉인 과정\n1. 원문 뒤에 A·Z 추가\n2. 각 문자를 3-1-4 반복만큼 전진\n3. 3×3 격자를 시계 방향 90도 회전",
            {
              "layout": "GRID",
              "text": "역회전 확인\nH R Y    E Q U\nL O S →  I N O\nA B D    X A Z"
            }
          ],
          "answerFormat": "영어 7글자",
          "answers": [
            "equinox"
          ],
          "normalization": "LETTERS_AND_DIGITS",
          "cooldownSeconds": 18,
          "difficulty": 5,
          "inspiration": "심야의 기록보관소 · 아홉 칸의 역회전",
          "solutionExplanation": "격자를 반시계 방향으로 되돌린 HRY/LOS/ABD에서 3-1-4를 빼면 EQU/INO/XAZ다. 덧글자 A·Z를 제거하면 EQUINOX다.",
          "wrongAnswerSamples": [
            "equinoxaz",
            "equinoxe",
            "equinoxza"
          ]
        }
      ],
      "hints": [
        {
          "tier": 1,
          "text": "가장 마지막 회전부터 반대로 되돌리세요."
        },
        {
          "tier": 2,
          "text": "반시계 회전 결과는 HRY/LOS/ABD입니다."
        },
        {
          "tier": 3,
          "text": "3-1-4를 빼고 마지막 A·Z를 제거하세요."
        }
      ],
      "messages": {
        "intro": "증거와 환경 장치를 조사한 뒤 /maze answer <정답>으로 제출하세요.",
